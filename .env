# Copy this file to .env and fill in the values before running.

# REQUIRED: A long, random secret used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Optional: Path to the SQLite database file (default: budget_tracker.db in cwd)
# DB_PATH=/data/budget_tracker.db
